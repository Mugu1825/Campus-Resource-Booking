# Hardened Dockerfile: Uses minimal Alpine base, non-root user, and security hardening
FROM python:3.12-alpine

# Set non-interactive and environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install minimal build dependencies and clean up cache in single layer
RUN apk update && apk add --no-cache \
    gcc \
    musl-dev \
    libffi-dev \
    && rm -rf /var/cache/apk/*

WORKDIR /app

# Install Python requirements
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt \
    && apk del gcc musl-dev libffi-dev \
    && rm -rf /var/cache/apk/*

# Copy backend application
COPY backend /app/backend

# Security Hardening: Create non-root unprivileged group and user
RUN addgroup -g 10001 -S appgroup && \
    adduser -u 10001 -S appuser -G appgroup -s /sbin/nologin && \
    chown -R appuser:appgroup /app

# Switch to non-root user
USER appuser

WORKDIR /app/backend
EXPOSE 5000

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--threads", "2", "app:app"]
